# HiveMQ Cloud (same cluster/credentials as the ESP32 firmware).
MQTT_URL=mqtts://<broker-id>.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Must match DEVICE_ID in the firmware: topics are smartlock/<DEVICE_ID>/...
DEVICE_ID=puerta01
PORT=3000

# MongoDB Atlas (historial). Usuario/contraseña con caracteres especiales deben ir URL-encoded.
# Atlas > Network Access: permitir tu IP (o 0.0.0.0/0 en desarrollo).
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=jelic

# Origen permitido por CORS para la API (ej. https://usuario.github.io). "*" = cualquiera.
CORS_ORIGIN=*

# Only if you later split the backend out: browser WebSocket URL.
# Empty = same-origin /ws (integrated mode).
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Solo si el front se sirve aparte (GitHub Pages): URL base del backend para la API REST.
# NEXT_PUBLIC_API_URL=https://tu-backend.onrender.com
